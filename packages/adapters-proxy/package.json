{
  "name": "@decide-router/adapters-proxy",
  "version": "0.1.0",
  "description": "Local OpenAI-compatible proxy for cascade/assist tool routing",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "decide-router-proxy": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@decide-router/core": "workspace:*",
    "@decide-router/backends": "workspace:*",
    "@decide-router/policy": "workspace:*",
    "@decide-router/trees": "workspace:*",
    "@decide-router/bootstrap": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

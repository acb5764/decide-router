{
  "version": 1,
  "description": "Claude Code / Agent Plugins hooks for Decide-Router",
  "hooks": {
    "SessionStart": {
      "command": "node",
      "args": ["${plugin}/dist/hooks/session-start.js"]
    },
    "PreToolUse": {
      "command": "node",
      "args": ["${plugin}/dist/hooks/pre-tool.js"],
      "matcher": ".*"
    },
    "PostToolUse": {
      "command": "node",
      "args": ["${plugin}/dist/hooks/post-tool.js"],
      "matcher": ".*"
    },
    "Stop": {
      "command": "node",
      "args": ["${plugin}/dist/hooks/stop.js"]
    }
  }
}

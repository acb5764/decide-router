{
  "name": "@decide-router/eval",
  "version": "0.1.0",
  "description": "Trace replay, threshold fitting, safety regression fixtures",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:safety": "tsx src/run-safety.ts"
  },
  "dependencies": {
    "@decide-router/core": "workspace:*",
    "@decide-router/backends": "workspace:*",
    "@decide-router/policy": "workspace:*",
    "@decide-router/trees": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@decide-router/adapters-cursor",
  "version": "0.1.0",
  "description": "Cursor authorization hooks for Decide-Router (fail-open)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "decide-router-cursor": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "hooks",
    "sample-config.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "install-hooks": "tsx src/cli.ts install"
  },
  "dependencies": {
    "@decide-router/core": "workspace:*",
    "@decide-router/backends": "workspace:*",
    "@decide-router/policy": "workspace:*",
    "@decide-router/trees": "workspace:*",
    "@decide-router/bootstrap": "workspace:*",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/decide-router-session-start.mjs",
        "timeout": 8
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/decide-router-before-shell.mjs",
        "timeout": 6
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "./hooks/decide-router-before-mcp.mjs",
        "timeout": 6
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/decide-router-pre-tool.mjs",
        "matcher": "Write|Delete|Edit|StrReplace",
        "timeout": 7
      }
    ],
    "stop": [
      {
        "command": "./hooks/decide-router-stop.mjs",
        "timeout": 5
      }
    ]
  }
}

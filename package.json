{
  "name": "decide-router",
  "version": "0.1.0",
  "private": true,
  "description": "Judgment + deterministic policy layer for agent harnesses",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "eval:safety": "pnpm --filter @decide-router/eval run eval:safety",
    "bootstrap": "pnpm --filter @decide-router/bootstrap exec tsx src/cli.ts",
    "skill": "pnpm --filter @decide-router/bootstrap exec tsx src/skill-cli.ts",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
